# Copy to .env.local and fill in. None of these are required for local dev —
# without them, contact form submissions are logged to the server console.

# --- Contact form email delivery (Resend: https://resend.com) ---------------
# Create an API key, verify your sending domain, then set all three.
RESEND_API_KEY=
# Must be an address on a domain verified with Resend
CONTACT_FROM_EMAIL="OVAL Website <website@ovalllc.net>"
# Where enquiries land. Defaults to site.email in src/lib/site.ts if unset.
CONTACT_TO_EMAIL=contant@ovalllc.net

# --- Stripe Payment Links --------------------------------------------------
# Create one Payment Link per package in the Stripe dashboard
# (Product catalogue → Payment links), then paste the URLs here.
#
# Until these are set, every buy button falls back to the contact form, so the
# site works fine while your Stripe account is still under review.
#
# NOTE: these are read at BUILD time. After changing them, redeploy.
STRIPE_LINK_SEO_AUDIT=
STRIPE_LINK_ON_PAGE_SEO=
STRIPE_LINK_LANDING_PAGE=
STRIPE_LINK_BUSINESS_WEBSITE=
